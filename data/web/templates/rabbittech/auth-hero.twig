{# Brand panel beside the sign-in forms (hidden on narrow screens) #}
<aside class="rt-auth-hero">
  <div class="rt-auth-hero-brand">{% include 'rabbittech/brand.twig' %}</div>
  <div class="rt-auth-hero-copy">
    <h2>Your mail, secured.</h2>
    <p>Email, calendars and contacts on infrastructure we run ourselves, protected on every message.</p>
    <ul class="rt-auth-points">
      <li><i class="bi bi-shield-check" aria-hidden="true"></i><span>Spam and malware filtering on all incoming mail</span></li>
      <li><i class="bi bi-calendar-week" aria-hidden="true"></i><span>Webmail, shared calendars and contacts in one place</span></li>
      <li><i class="bi bi-phone" aria-hidden="true"></i><span>Works with Outlook, Apple Mail and mobile apps</span></li>
      <li><i class="bi bi-fingerprint" aria-hidden="true"></i><span>Two-factor and passkey sign-in</span></li>
    </ul>
  </div>
  <div class="rt-auth-hero-foot"><i class="bi bi-hdd-network" aria-hidden="true"></i>{{ mailcow_hostname }}</div>
</aside>
