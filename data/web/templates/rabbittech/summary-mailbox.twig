{# Summary of the mailbox being edited, shown above the edit tabs #}
{% set rt_display = result.name|default(result.local_part)|trim %}
{% set rt_words = rt_display|split(' ')|filter(w => w != '') %}
{% set rt_initials = (rt_words|first|first ~ (rt_words|length > 1 ? rt_words|last|first : ''))|upper %}
{% set rt_used = result.quota_used|default(0) %}
{% set rt_pct = result.quota > 0 ? min(100, (rt_used / result.quota * 100)|round) : null %}
{% set rt_logins = {'IMAP': result.last_imap_login, 'SMTP': result.last_smtp_login, 'POP3': result.last_pop3_login, 'SSO': result.last_sso_login} %}
{% set rt_last = 0 %}
{% set rt_last_via = '' %}
{% for via, ts in rt_logins %}
  {% if ts|default(0) > rt_last %}{% set rt_last = ts %}{% set rt_last_via = via %}{% endif %}
{% endfor %}
<section class="rt-summary" aria-label="{{ lang.mailbox.mailbox }}">
  <div class="rt-summary-head">
    <span class="rt-avatar rt-summary-avatar" aria-hidden="true">{{ rt_initials }}</span>
    <div class="rt-summary-identity">
      <div class="rt-summary-titleline">
        <h2 class="rt-summary-title">{{ rt_display }}</h2>
        {% if result.active == '1' %}
        <span class="rt-status rt-status-running">{{ lang.edit.active }}</span>
        {% elseif result.active == '2' %}
        <span class="rt-status rt-status-warning" title="{{ lang.edit.disable_login }}">Login disabled</span>
        {% else %}
        <span class="rt-status rt-status-muted">{{ lang.edit.inactive }}</span>
        {% endif %}
      </div>
      <div class="rt-summary-sub">
        <span>{{ result.username }}</span>
        {% if result.authsource and result.authsource != 'mailcow' %}<span class="rt-chip">{{ result.authsource }}</span>{% endif %}
        {% for tag in result.tags|default([]) %}<span class="rt-chip">{{ tag }}</span>{% endfor %}
      </div>
    </div>
    {% if acl.login_as == 1 and mailcow_cc_role in ['admin', 'domainadmin'] %}
    <div class="rt-summary-actions">
      <a class="btn btn-secondary" href="/index.php?duallogin={{ result.username|url_encode }}"><i class="bi bi-box-arrow-in-right"></i> Log in as</a>
    </div>
    {% endif %}
  </div>
  <dl class="rt-summary-stats">
    <div class="rt-summary-stat rt-summary-stat-wide">
      <dt>Storage</dt>
      <dd>{{ rt_used > 0 ? rt_used|formatBytes(1) : '0 B' }} <small>of {{ result.quota > 0 ? result.quota|formatBytes(1) : '∞' }}</small></dd>
      {% if rt_pct is not null %}
      <div class="rt-usage {% if rt_pct >= 90 %}rt-usage-danger{% elseif rt_pct >= 75 %}rt-usage-warning{% else %}rt-usage-ok{% endif %}">
        <div class="rt-usage-track"><div class="rt-usage-bar" style="width: {{ rt_pct }}%"></div></div>
      </div>
      {% endif %}
    </div>
    <div class="rt-summary-stat">
      <dt>{{ lang.user.messages|capitalize }}</dt>
      <dd>{{ result.messages|default(0)|number_format(0, '.', ',') }}</dd>
    </div>
    <div class="rt-summary-stat">
      <dt>{{ lang.mailbox.last_mail_login }}</dt>
      {% if rt_last > 0 %}
      <dd><time datetime="{{ rt_last|date('c') }}" data-rt-time="{{ rt_last }}" title="{{ rt_last|date('Y-m-d H:i') }}">{{ rt_last|date('Y-m-d H:i') }}</time></dd>
      <div class="rt-summary-note">via {{ rt_last_via }}</div>
      {% else %}
      <dd class="rt-summary-muted">{{ lang.user.never }}</dd>
      {% endif %}
    </div>
    <div class="rt-summary-stat">
      <dt>{{ lang.edit.created_on }}</dt>
      <dd>{{ result.created|date('M j, Y') }}</dd>
      <div class="rt-summary-note">{{ lang.edit.last_modified }}: {{ result.modified ? result.modified|date('M j, Y') : lang.user.never }}</div>
    </div>
  </dl>
</section>
