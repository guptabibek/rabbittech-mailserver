{# Option buttons post to the API through the shared data-action handler; the selected one is .btn-dark #}
{% macro option(label, selected, id, api_url, api_attr, username) %}
  <button type="button" class="btn btn-sm{% if selected %} btn-dark{% else %} btn-light{% endif %}" aria-pressed="{{ selected ? 'true' : 'false' }}"
    data-action="edit_selected" data-item="{{ username }}" data-id="{{ id }}" data-api-url="{{ api_url }}" data-api-attr="{{ api_attr }}">{{ label }}</button>
{% endmacro %}
<div class="tab-pane fade" id="tab-user-settings" role="tabpanel" aria-labelledby="tab-user-settings">
  <section class="card rt-panel mb-4">
    <div class="card-header"><h3 class="rt-panel-title"><i class="bi bi-envelope-paper"></i> Mail handling</h3></div>
    <div class="rt-setting-list">
      <div class="rt-setting rt-setting-wrap">
        <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-tags"></i></span>
        <div class="rt-setting-body">
          <div class="rt-setting-title">{{ lang.user.tag_handling }}</div>
          <div class="rt-setting-desc">{{ lang.user.tag_help_explain|raw }}</div>
          <div class="rt-setting-desc">{{ lang.user.tag_help_example|raw }}</div>
        </div>
        <div class="rt-setting-detail">
          <div class="btn-group rt-segmented" role="group" aria-label="{{ lang.user.tag_handling }}" data-acl="{{ acl.delimiter_action }}">
            {{ _self.option(lang.user.tag_in_subfolder, get_tagging_options == 'subfolder', 'delimiter_action', 'edit/delimiter_action', '{"tagged_mail_handler":"subfolder"}', mailcow_cc_username) }}
            {{ _self.option(lang.user.tag_in_subject, get_tagging_options == 'subject', 'delimiter_action', 'edit/delimiter_action', '{"tagged_mail_handler":"subject"}', mailcow_cc_username) }}
            {{ _self.option(lang.user.tag_in_none, get_tagging_options == 'none', 'delimiter_action', 'edit/delimiter_action', '{"tagged_mail_handler":"none"}', mailcow_cc_username) }}
          </div>
        </div>
      </div>
      <div class="rt-setting rt-setting-wrap">
        <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-lock"></i></span>
        <div class="rt-setting-body">
          <div class="rt-setting-title">{{ lang.user.tls_policy }}</div>
          <div class="rt-setting-desc">{{ lang.user.tls_policy_warning|raw }}</div>
        </div>
        <div class="rt-setting-detail">
          <div class="btn-group rt-segmented rt-toggles" role="group" aria-label="{{ lang.user.tls_policy }}" data-acl="{{ acl.tls_policy }}">
            {{ _self.option(lang.user.tls_enforce_in, get_tls_policy.tls_enforce_in == '1', 'tls_policy', 'edit/tls_policy', '{"tls_enforce_in": ' ~ (get_tls_policy.tls_enforce_in == '1' ? 0 : 1) ~ '}', mailcow_cc_username) }}
            {{ _self.option(lang.user.tls_enforce_out, get_tls_policy.tls_enforce_out == '1', 'tls_policy', 'edit/tls_policy', '{"tls_enforce_out": ' ~ (get_tls_policy.tls_enforce_out == '1' ? 0 : 1) ~ '}', mailcow_cc_username) }}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="card rt-panel mb-4">
    <div class="card-header"><h3 class="rt-panel-title"><i class="bi bi-shield-exclamation"></i> Quarantine</h3></div>
    <div class="rt-setting-list">
      <div class="rt-setting rt-setting-wrap">
        <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-bell"></i></span>
        <div class="rt-setting-body">
          <div class="rt-setting-title">{{ lang.user.quarantine_notification }}</div>
          <div class="rt-setting-desc">{{ lang.user.quarantine_notification_info }}</div>
        </div>
        <div class="rt-setting-detail">
          <div class="btn-group rt-segmented" role="group" aria-label="{{ lang.user.quarantine_notification }}" data-acl="{{ acl.quarantine_notification }}">
            {% for value, label in {'never': lang.user.never, 'hourly': lang.user.hourly, 'daily': lang.user.daily, 'weekly': lang.user.weekly} %}
            {{ _self.option(label, quarantine_notification == value, 'quarantine_notification', 'edit/quarantine_notification', '{"quarantine_notification":"' ~ value ~ '"}', mailcow_cc_username) }}
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="rt-setting rt-setting-wrap">
        <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-funnel"></i></span>
        <div class="rt-setting-body">
          <div class="rt-setting-title">{{ lang.user.quarantine_category }}</div>
          <div class="rt-setting-desc">{{ lang.user.quarantine_category_info }}</div>
        </div>
        <div class="rt-setting-detail">
          <div class="btn-group rt-segmented" role="group" aria-label="{{ lang.user.quarantine_category }}" data-acl="{{ acl.quarantine_category }}">
            {% for value, label in {'reject': lang.user.q_reject, 'add_header': lang.user.q_add_header, 'all': lang.user.q_all} %}
            {{ _self.option(label, quarantine_category == value, 'quarantine_category', 'edit/quarantine_category', '{"quarantine_category":"' ~ value ~ '"}', mailcow_cc_username) }}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  {% if not skip_sogo %}
  <section class="card rt-panel rt-panel-danger mb-4">
    <div class="card-header"><h3 class="rt-panel-title"><i class="bi bi-arrow-counterclockwise"></i> Reset</h3></div>
    <div class="rt-setting-list">
      <div class="rt-setting">
        <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-phone-vibrate"></i></span>
        <div class="rt-setting-body">
          <div class="rt-setting-title">{{ lang.user.eas_reset }}</div>
          <div class="rt-setting-desc">{{ lang.user.eas_reset_help|raw }}</div>
        </div>
        <div class="rt-setting-action">
          <button class="btn btn-secondary" data-action="delete_selected" data-text="{{ lang.user.eas_reset }}?" data-item="{{ mailcow_cc_username }}" data-acl="{{ acl.eas_reset }}" data-id="eas_cache" data-api-url='delete/eas_cache' href="#">{{ lang.user.eas_reset_now }}</button>
        </div>
      </div>
      <div class="rt-setting">
        <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-person-x"></i></span>
        <div class="rt-setting-body">
          <div class="rt-setting-title">{{ lang.user.sogo_profile_reset }}</div>
          <div class="rt-setting-desc">{{ lang.user.sogo_profile_reset_help|raw }}</div>
        </div>
        <div class="rt-setting-action">
          <button class="btn btn-outline-danger" data-action="delete_selected" data-text="{{ lang.user.sogo_profile_reset }}?" data-item="{{ mailcow_cc_username }}" data-acl="{{ acl.sogo_profile_reset }}" data-id="sogo_profile" data-api-url='delete/sogo_profile' href="#">{{ lang.user.sogo_profile_reset_now }}</button>
        </div>
      </div>
    </div>
  </section>
  {% endif %}
</div>
