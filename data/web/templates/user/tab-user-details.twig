{% macro address_list(items, none_label) %}
  {% set items = items|filter(i => i|trim != '') %}
  {% if items %}
  <ul class="rt-address-list">
    {% for item in items %}<li><i class="bi bi-envelope" aria-hidden="true"></i><span>{{ item|trim }}</span></li>{% endfor %}
  </ul>
  {% else %}
  <div class="rt-setting-empty">{{ none_label }}</div>
  {% endif %}
{% endmacro %}
<div class="tab-pane fade" id="tab-user-details" role="tabpanel" aria-labelledby="tab-user-details">
  {% set t = lang.rabbittech %}
  <div class="row g-4">
    <div class="col-xl-7">
      <section class="card rt-panel h-100">
        <div class="card-header"><h2 class="rt-panel-title"><i class="bi bi-inbox" aria-hidden="true"></i> {{ t.receiving }}</h2></div>
        <div class="rt-setting-list">
          <div class="rt-setting rt-setting-wrap">
            <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-pin-angle"></i></span>
            <div class="rt-setting-body">
              <div class="rt-setting-title">{{ lang.user.direct_aliases }}</div>
              <div class="rt-setting-desc">{{ lang.user.direct_aliases_desc }}</div>
            </div>
            <div class="rt-setting-detail">
              {% if user_get_alias_details.direct_aliases %}
              <ul class="rt-address-list">
                {% for direct_alias, direct_alias_meta in user_get_alias_details.direct_aliases %}
                <li><i class="bi bi-envelope" aria-hidden="true"></i><span>{{ direct_alias }}</span>{% if direct_alias_meta.public_comment %}<small><i class="bi bi-chat-left" aria-hidden="true"></i> {# already HTML-escaped by user_get_alias_details() #}{{ direct_alias_meta.public_comment|raw }}</small>{% endif %}</li>
                {% endfor %}
              </ul>
              {% else %}
              <div class="rt-setting-empty">{{ none_label }}</div>
              {% endif %}
            </div>
          </div>
          <div class="rt-setting rt-setting-wrap">
            <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-share"></i></span>
            <div class="rt-setting-body">
              <div class="rt-setting-title">{{ lang.user.shared_aliases }}</div>
              <div class="rt-setting-desc">{{ lang.user.shared_aliases_desc }}</div>
            </div>
            <div class="rt-setting-detail">
              {% if user_get_alias_details.shared_aliases %}
              <ul class="rt-address-list">
                {% for shared_alias, shared_alias_meta in user_get_alias_details.shared_aliases %}
                <li><i class="bi bi-envelope" aria-hidden="true"></i><span>{{ shared_alias }}</span>{% if shared_alias_meta.public_comment %}<small><i class="bi bi-chat-left" aria-hidden="true"></i> {# already HTML-escaped by user_get_alias_details() #}{{ shared_alias_meta.public_comment|raw }}</small>{% endif %}</li>
                {% endfor %}
              </ul>
              {% else %}
              <div class="rt-setting-empty">{{ none_label }}</div>
              {% endif %}
            </div>
          </div>
          <div class="rt-setting rt-setting-wrap">
            <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-asterisk"></i></span>
            <div class="rt-setting-body">
              <div class="rt-setting-title">{{ lang.user.is_catch_all }}</div>
              <div class="rt-setting-desc">{{ t.catch_all_desc }}</div>
            </div>
            <div class="rt-setting-detail">{{ _self.address_list(user_get_alias_details.is_catch_all|default('')|split(','), lang.user.no_record) }}</div>
          </div>
        </div>
      </section>
    </div>
    <div class="col-xl-5">
      <section class="card rt-panel h-100">
        <div class="card-header"><h2 class="rt-panel-title"><i class="bi bi-send" aria-hidden="true"></i> {{ t.sending }}</h2></div>
        <div class="rt-setting-list">
          <div class="rt-setting rt-setting-wrap">
            <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
            <div class="rt-setting-body">
              <div class="rt-setting-title">{{ lang.user.aliases_also_send_as }}</div>
            </div>
            <div class="rt-setting-detail">
              {% if user_get_alias_details.aliases_also_send_as == '*' %}
              <div class="alert alert-warning mb-0">{{ lang.user.sender_acl_disabled|raw }}</div>
              {% else %}
              {{ _self.address_list(user_get_alias_details.aliases_also_send_as|default('')|split(','), lang.user.no_record) }}
              {% endif %}
            </div>
          </div>
          <div class="rt-setting rt-setting-wrap">
            <span class="rt-setting-icon" aria-hidden="true"><i class="bi bi-globe2"></i></span>
            <div class="rt-setting-body">
              <div class="rt-setting-title">{{ lang.user.aliases_send_as_all }}</div>
            </div>
            <div class="rt-setting-detail">{{ _self.address_list(user_get_alias_details.aliases_send_as_all|default('')|split(','), lang.user.no_record) }}</div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
