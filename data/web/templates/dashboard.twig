{% extends 'base.twig' %}

{% block content %}
<ul class="nav nav-tabs rt-managed-tabs" role="tablist">
  <li role="presentation" class="nav-item"><button class="nav-link active" data-bs-target="#tab-containers" aria-controls="tab-containers" role="tab" data-bs-toggle="tab">{{ lang.debug.system_containers }}</button></li>
  <li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">{{ lang.debug.logs }}</a>
    <ul class="dropdown-menu">
      <li role="presentation"><span class="dropdown-header fs-6">{{ lang.debug.in_memory_logs }}</span></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-postfix-logs" aria-selected="false" aria-controls="tab-postfix-logs" role="tab" data-bs-toggle="tab">Postfix</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-dovecot-logs" aria-selected="false" aria-controls="tab-dovecot-logs" role="tab" data-bs-toggle="tab">Dovecot</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-sogo-logs" aria-selected="false" aria-controls="tab-sogo-logs" role="tab" data-bs-toggle="tab">SOGo</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-netfilter-logs" aria-selected="false" aria-controls="tab-netfilter-logs" role="tab" data-bs-toggle="tab">Netfilter</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-autodiscover-logs" aria-selected="false" aria-controls="tab-autodiscover-logs" role="tab" data-bs-toggle="tab">Autodiscover</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-watchdog-logs" aria-selected="false" aria-controls="tab-watchdog-logs" role="tab" data-bs-toggle="tab">Watchdog</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-acme-logs" aria-selected="false" aria-controls="tab-acme-logs" role="tab" data-bs-toggle="tab">ACME</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-api-logs" aria-selected="false" aria-controls="tab-api-logs" role="tab" data-bs-toggle="tab">API</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-api-rl" aria-selected="false" aria-controls="tab-api-rl" role="tab" data-bs-toggle="tab">Ratelimits</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-cron-logs" aria-selected="false" aria-controls="tab-api-rl" role="tab" data-bs-toggle="tab">Crontasks</button></li>
      <li role="presentation"><span class="dropdown-header fs-6">{{ lang.debug.external_logs }}</span></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-rspamd-history" aria-selected="false" aria-controls="tab-rspamd-history" role="tab" data-bs-toggle="tab">Rspamd</button></li>
      <li role="presentation"><span class="dropdown-header fs-6">{{ lang.debug.static_logs }}</span></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-ui" aria-selected="false" aria-controls="tab-ui" role="tab" data-bs-toggle="tab">{{ lang.rabbittech.logs_console }}</button></li>
      <li role="presentation"><button class="dropdown-item" data-bs-target="#tab-sasl" aria-selected="false" aria-controls="tab-sasl" role="tab" data-bs-toggle="tab">SASL</button></li>
    </ul>
  </li>
</ul>

<div class="row">
  <div class="col-md-12">
    <div class="tab-content" style="padding-top:20px">
      <div role="tabpanel" class="tab-pane active" id="tab-containers">
        {% set rt_containers_running = containers|filter(c => c.State.Running == 1)|length %}
        {% set rt_containers_total = containers|length %}
        {% set t = lang.rabbittech %}

        {# Problems found on the server (admin/dashboard.php); 014-rabbittech.js adds the mail queue #}
        <section class="rt-alerts mb-4" id="rt-alerts" aria-labelledby="rt-alerts-title"{% if not rt_alerts %} hidden{% endif %}>
          <h2 class="rt-alerts-title" id="rt-alerts-title"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>{{ t.alert_title }}</h2>
          <ul class="rt-alerts-list">
            {% for alert in rt_alerts|default([]) %}
            {%- if alert.key starts with 'cert_' -%}
              {%- set rt_value = '<time datetime="' ~ alert.value|date('Y-m-d') ~ '" data-rt-date>' ~ alert.value|date('Y-m-d') ~ '</time>' -%}
            {%- elseif alert.key starts with 'container_' -%}
              {%- set rt_value = '<strong>' ~ (t['svc_' ~ alert.value]|default(alert.value))|e ~ '</strong>' -%}
            {%- else -%}
              {%- set rt_value = '<strong>' ~ alert.value|e ~ '</strong>' -%}
            {%- endif %}
            <li class="rt-alert rt-alert-{{ alert.level }}">
              <span class="rt-alert-text">{{ t['alert_' ~ alert.key]|format(rt_value)|raw }}</span>
              <span class="rt-alert-hint">{{ t['alert_' ~ alert.key ~ '_hint'] }}</span>
            </li>
            {% endfor %}
          </ul>
        </section>

        {# Live counts, loaded by 014-rabbittech.js from the API #}
        <div class="rt-kpi-grid mb-4" id="rt-kpis"{% if quarantine_count is not null %} data-quarantine-count="{{ quarantine_count }}"{% endif %}>
          {% for kpi in [
            { key: 'domains', label: lang.mailbox.domains, icon: 'globe2', href: '/admin/mailbox#/domains' },
            { key: 'mailboxes', label: lang.mailbox.mailboxes, icon: 'inbox', href: '/admin/mailbox#/mailboxes' },
            { key: 'aliases', label: lang.mailbox.aliases, icon: 'at', href: '/admin/mailbox#/mbox-aliases' },
            { key: 'queue', label: t.nav_mail_queue, icon: 'hourglass-split', href: '/admin/queue' },
            { key: 'quarantine', label: lang.header.quarantine, icon: 'shield-exclamation', href: '/quarantine' },
          ] %}
          <a class="rt-kpi" href="{{ kpi.href }}" data-rt-kpi="{{ kpi.key }}">
            <span class="rt-kpi-head">
              <span class="rt-kpi-label">{{ kpi.label }}</span>
              <span class="rt-kpi-icon" aria-hidden="true"><i class="bi bi-{{ kpi.icon }}"></i></span>
            </span>
            <span class="rt-kpi-value"><span class="rt-skeleton" aria-hidden="true"></span></span>
            <span class="rt-kpi-sub">&nbsp;</span>
          </a>
          {% endfor %}
        </div>

        <div class="row g-4 mb-4">
          <div class="col-xl-8">
            <div class="card rt-overview h-100">
              <div class="card-body">
                <div class="rt-overview-head">
                  <span class="rt-container-icon rt-overview-icon" aria-hidden="true"><i class="bi bi-hdd-stack"></i></span>
                  <div class="rt-overview-title">
                    <span class="rt-eyebrow">{{ t.server }}</span>
                    <h2>{{ hostname }}</h2>
                    <dl class="rt-meta">
                      <div><dt><i class="bi bi-globe2" aria-hidden="true"></i>{{ lang.debug.timezone }}</dt><dd>{{ timezone }}</dd></div>
                      <div><dt><i class="bi bi-cpu" aria-hidden="true"></i>{{ lang.debug.architecture }}</dt><dd id="host_architecture">-</dd></div>
                    </dl>
                  </div>
                  {# No containers means the Docker API didn't answer, not that everything runs #}
                  {% if rt_containers_total == 0 %}
                  <a class="rt-status rt-status-warning" href="#rt-services">{{ t.status_unavailable }}</a>
                  {% elseif rt_containers_running == rt_containers_total %}
                  <a class="rt-status rt-status-running" href="#rt-services">{{ t.all_services_running }}</a>
                  {% else %}
                  <a class="rt-status rt-status-stopped" href="#rt-services">{{ rt_containers_total - rt_containers_running }} {{ lang.debug.container_stopped|lower }}</a>
                  {% endif %}
                </div>

            <div class="rt-stat-grid">
              <div class="rt-stat">
                <div class="rt-stat-label"><i class="bi bi-tag" aria-hidden="true"></i>{{ t.version }}</div>
                <div class="rt-stat-value">
                  <a href="#" id="mailcow_version">{{ mailcow_info.version_tag }}</a>
                  <p id="mailcow_update" class="rt-stat-sub"></p>
                </div>
              </div>
              <div class="rt-stat">
                <div class="rt-stat-label"><i class="bi bi-clock-history" aria-hidden="true"></i>{{ lang.debug.uptime }}</div>
                <div class="rt-stat-value">
                  <span id="host_uptime">-</span>
                  <span class="rt-stat-sub">{{ lang.debug.current_time }}: <span id="host_date">-</span></span>
                </div>
              </div>
              <div class="rt-stat">
                <div class="rt-stat-label"><i class="bi bi-hdd" aria-hidden="true"></i>{{ lang.debug.disk_usage }}</div>
                <div class="rt-stat-value">
                  {{ vmail_df[2] }} / {{ vmail_df[1] }}
                  <span class="rt-stat-sub">{{ vmail_df[0] }} &middot; {{ vmail_df[4] }}</span>
                </div>
                <div class="progress">
                  <div class="progress-bar bg-info" role="progressbar" style="width:{{ vmail_df[4] }}" aria-valuenow="{{ vmail_df[4]|trim('%') }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ lang.debug.disk_usage }}"></div>
                </div>
              </div>
              <div class="rt-stat">
                <div class="rt-stat-label"><i class="bi bi-diagram-3" aria-hidden="true"></i>{{ t.ip_addresses }}</div>
                <div class="rt-stat-value">
                  {% if ip_check == 1 %}
                    <span class="d-none" id="host_ipv4">-</span>
                    <span class="d-none rt-stat-sub" id="host_ipv6">-</span>
                    <button class="d-block btn btn-secondary btn-sm" id="host_show_ip">
                      <span class="text">{{ lang.debug.show_ip }}</span>
                      <div class="spinner-border spinner-border-sm d-none" role="status">
                        <span class="visually-hidden">Loading...</span>
                      </div>
                    </button>
                  {% else %}
                    <span class="rt-stat-sub">{{ lang.admin.ip_check_disabled|raw }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
              </div>
            </div>
          </div>
          <div class="col-xl-4">
            <div class="card h-100">
              <div class="card-header d-flex">
                <h2 class="rt-card-title"><i class="bi bi-lightning-charge me-2" aria-hidden="true"></i>{{ t.quick_actions }}</h2>
              </div>
              <div class="card-body rt-quick-list">
                <a class="rt-quick-item" href="/admin/mailbox#/domains" data-rt-open-modal="addDomainModal">
                  <span class="rt-quick-icon" aria-hidden="true"><i class="bi bi-globe2"></i></span>
                  <span class="rt-quick-text"><strong>{{ lang.mailbox.add_domain }}</strong><small>{{ t.quick_add_domain }}</small></span>
                  <i class="bi bi-chevron-right rt-quick-go" aria-hidden="true"></i>
                </a>
                <a class="rt-quick-item" href="/admin/mailbox#/mailboxes" data-rt-open-modal="addMailboxModal">
                  <span class="rt-quick-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
                  <span class="rt-quick-text"><strong>{{ lang.mailbox.add_mailbox }}</strong><small>{{ t.quick_add_mailbox }}</small></span>
                  <i class="bi bi-chevron-right rt-quick-go" aria-hidden="true"></i>
                </a>
                <a class="rt-quick-item" href="/admin/mailbox#/mbox-aliases" data-rt-open-modal="addAliasModal">
                  <span class="rt-quick-icon" aria-hidden="true"><i class="bi bi-at"></i></span>
                  <span class="rt-quick-text"><strong>{{ lang.mailbox.add_alias }}</strong><small>{{ t.quick_add_alias }}</small></span>
                  <i class="bi bi-chevron-right rt-quick-go" aria-hidden="true"></i>
                </a>
                <a class="rt-quick-item" href="/admin/system#/config-dkim">
                  <span class="rt-quick-icon" aria-hidden="true"><i class="bi bi-key"></i></span>
                  <span class="rt-quick-text"><strong>DKIM</strong><small>{{ t.quick_dkim }}</small></span>
                  <i class="bi bi-chevron-right rt-quick-go" aria-hidden="true"></i>
                </a>
                {% if not skip_sogo %}
                <button type="button" class="rt-quick-item" data-bs-toggle="modal" data-container="sogo-mailcow" data-bs-target="#RestartContainer">
                  <span class="rt-quick-icon" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                  <span class="rt-quick-text"><strong>{{ lang.header.restart_sogo }}</strong><small>{{ t.quick_restart_sogo }}</small></span>
                  <i class="bi bi-chevron-right rt-quick-go" aria-hidden="true"></i>
                </button>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-lg-6">
            <div class="card rt-chart-card h-100">
              <div class="card-header d-flex">
                <h2 class="rt-card-title"><i class="bi bi-cpu me-2" aria-hidden="true"></i>CPU</h2>
                <span class="rt-chart-meta"><strong><span id="host_cpu_cores">-</span> {{ lang.debug.cores }}</strong> @ <span id="host_cpu_usage"></span></span>
              </div>
              <div class="card-body">
                <canvas id="host_cpu_chart" width="400" height="200"></canvas>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="card rt-chart-card h-100">
              <div class="card-header d-flex">
                <h2 class="rt-card-title"><i class="bi bi-memory me-2" aria-hidden="true"></i>{{ lang.debug.memory }}</h2>
                <span class="rt-chart-meta"><strong id="host_memory_total">-</strong> @ <span id="host_memory_usage"></span></span>
              </div>
              <div class="card-body">
                <canvas id="host_mem_chart" width="400" height="200"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- container info -->
        <div class="card mb-4" id="rt-services">
          <div class="card-header d-flex rt-section-head">
            <h2 class="rt-card-title"><i class="bi bi-boxes me-2" aria-hidden="true"></i>{{ lang.debug.containers_info }}</h2>
            <span class="rt-count">
              <span class="badge bg-success">{{ rt_containers_running }} {{ lang.debug.container_running|lower }}</span>
              {% if rt_containers_running != rt_containers_total %}
              <span class="badge bg-danger">{{ rt_containers_total - rt_containers_running }} {{ lang.debug.container_stopped|lower }}</span>
              {% endif %}
            </span>
          </div>
          <div class="card-body p-0">
            <div class="rt-container-grid">
              {% for container, container_info in containers %}
                {% set rt_running = container_info.State.Running == 1 %}
                <div class="rt-container{% if not rt_running %} is-stopped{% endif %}">
                  <div class="rt-container-head">
                    <span class="rt-container-icon" aria-hidden="true"><i class="bi bi-box-seam"></i></span>
                    <div class="rt-container-body">
                      {% set rt_service = container|replace({'-mailcow': ''}) %}
                      <h3 class="rt-container-name"><span>{{ t['svc_' ~ rt_service]|default(rt_service) }}</span><span class="rt-container-id">{{ container }}</span></h3>
                      <div class="rt-container-meta">
                        <span class="rt-image-tag" title="{{ container_info.Config.Image }}">{{ container_info.Config.Image }}</span>
                        <span><i class="bi bi-clock-history me-1" aria-hidden="true"></i><span class="visually-hidden">{{ lang.debug.started_on }}: </span><span class="parse_date">{{ container_info.State.StartedAtHR }}</span></span>
                      </div>
                    </div>
                    {% if rt_running %}
                      <span class="rt-status rt-status-running">{{ lang.debug.container_running }}</span>
                    {% elseif container_info.State %}
                      <span class="rt-status rt-status-stopped">{{ lang.debug.container_stopped }}</span>
                    {% endif %}
                    <button class="rt-icon-btn rt-container-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#{{ container }}Collapse" aria-expanded="false" aria-controls="{{ container }}Collapse" aria-label="{{ t.show_details|format(container) }}">
                      <i class="bi bi-chevron-down caret" aria-hidden="true"></i>
                    </button>
                  </div>
                  <div class="collapse rt-container-details container-details-collapse" id="{{ container }}Collapse" data-id="{{ container_info.Id }}">
                    <div class="row g-3 p-3">
                      <div class="col-sm-12 col-md-6 d-flex flex-column">
                        <h4 class="rt-chart-title">Disk I/O</h4>
                        <div class="spinner-border my-4 mx-auto" role="status">
                          <span class="visually-hidden">Loading...</span>
                        </div>
                        <canvas class="d-none" id="{{ container }}_DiskIOChart" width="400" height="200"></canvas>
                      </div>
                      <div class="col-sm-12 col-md-6 d-flex flex-column">
                        <h4 class="rt-chart-title">Net I/O</h4>
                        <div class="spinner-border my-4 mx-auto" role="status">
                          <span class="visually-hidden">Loading...</span>
                        </div>
                        <canvas class="d-none" id="{{ container }}_NetIOChart" width="400" height="200"></canvas>
                      </div>
                      <div class="col-12 d-flex">
                        <button type="button" data-bs-toggle="modal"
                          data-container="{{ container }}"
                          data-bs-target="#RestartContainer"
                          class="btn btn-sm btn-secondary ms-auto">
                          <i class="bi bi-arrow-repeat" aria-hidden="true"></i>{{ lang.debug.restart_container }}
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        {# mailcow's GUID and support-license card is left out: it belongs to mailcow's own support offer #}
      </div>

      <div role="tabpanel" class="tab-pane" id="tab-postfix-logs">
        <div class="debug-log-info">{{ lang.debug.log_info|format(log_lines+1)|raw }}</div>
        <div class="card">
          <div class="card-header d-flex align-items-center fs-5">
            <span class="mt-2 ms-2">Postfix</span>
            <div class="btn-group ms-auto">
              <button class="btn btn-sm btn-secondary refresh_table" data-draw="draw_postfix_logs" data-table="postfix_log">{{ lang.admin.refresh }}</button>
            </div>
          </div>
          <div class="card-body">
            <a class="btn btn-sm btn-secondary dropdown-toggle mb-4" data-bs-toggle="dropdown" href="#">{{ lang.mailbox.quick_actions }}</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item add_log_lines" data-post-process="general_syslog" data-table="postfix_log" data-log-url="postfix" data-nrows="100" href="#">+ 100</a></li>
              <li><a class="dropdown-item add_log_lines" data-post-process="general_syslog" data-table="postfix_log" data-log-url="postfix" data-nrows="1000" href="#">+ 1000</a></li>
              <li class="table_collapse_option"><hr class="dropdown-divider"></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-expand="postfix_log" data-table="postfix_log" href="#">{{ lang.datatables.expand_all }}</a></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-collapse="postfix_log" data-table="postfix_log" href="#">{{ lang.datatables.collapse_all }}</a></li>
            </ul>
            <table id="postfix_log" class="table table-striped dt-responsive w-100"></table>
          </div>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="tab-ui">
        <div class="debug-log-info">{{ lang.debug.log_info|format(log_lines+1)|raw }}</div>
        <div class="card">
          <div class="card-header d-flex align-items-center fs-5">
            <span class="mt-2 ms-2">{{ lang.rabbittech.logs_console }}</span>
            <div class="btn-group ms-auto">
              <button class="btn btn-sm btn-secondary refresh_table" data-draw="draw_ui_logs" data-table="ui_logs">{{ lang.admin.refresh }}</button>
            </div>
          </div>
          <div class="card-body">
            <a class="btn btn-sm btn-secondary dropdown-toggle mb-4" data-bs-toggle="dropdown" href="#">{{ lang.mailbox.quick_actions }}</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item add_log_lines" data-post-process="mailcow_ui" data-table="ui_logs" data-log-url="ui" data-nrows="100" href="#">+ 100</a></li>
              <li><a class="dropdown-item add_log_lines" data-post-process="mailcow_ui" data-table="ui_logs" data-log-url="ui" data-nrows="1000" href="#">+ 1000</a></li>
              <li class="table_collapse_option"><hr class="dropdown-divider"></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-expand="ui_logs" data-table="ui_logs" href="#">{{ lang.datatables.expand_all }}</a></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-collapse="ui_logs" data-table="ui_logs" href="#">{{ lang.datatables.collapse_all }}</a></li>
            </ul>
            <table id="ui_logs" class="table table-striped dt-responsive w-100"></table>
          </div>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="tab-sasl">
        <div class="debug-log-info">{{ lang.debug.log_info|format(log_lines+1)|raw }}</div>
        <div class="card">
          <div class="card-header d-flex align-items-center fs-5">
            <span class="mt-2 ms-2">SASL</span>
            <div class="btn-group ms-auto">
              <button class="btn btn-sm btn-secondary refresh_table" data-draw="draw_sasl_logs" data-table="sasl_logs">{{ lang.admin.refresh }}</button>
            </div>
          </div>
          <div class="card-body">
            <a class="btn btn-sm btn-secondary dropdown-toggle mb-4" data-bs-toggle="dropdown" href="#">{{ lang.mailbox.quick_actions }}</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item add_log_lines" data-post-process="sasl_log_table" data-table="sasl_logs" data-log-url="ui" data-nrows="100" href="#">+ 100</a></li>
              <li><a class="dropdown-item add_log_lines" data-post-process="sasl_log_table" data-table="sasl_logs" data-log-url="ui" data-nrows="1000" href="#">+ 1000</a></li>
              <li class="table_collapse_option"><hr class="dropdown-divider"></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-expand="sasl_logs" data-table="sasl_logs" href="#">{{ lang.datatables.expand_all }}</a></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-collapse="sasl_logs" data-table="sasl_logs" href="#">{{ lang.datatables.collapse_all }}</a></li>
            </ul>
            <table id="sasl_logs" class="table table-striped dt-responsive w-100"></table>
          </div>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="tab-dovecot-logs">
        <div class="debug-log-info">{{ lang.debug.log_info|format(log_lines+1)|raw }}</div>
        <div class="card">
          <div class="card-header d-flex align-items-center fs-5">
            <span class="mt-2 ms-2">Dovecot</span>
            <div class="btn-group ms-auto">
              <button class="btn btn-sm btn-secondary refresh_table" data-draw="draw_dovecot_logs" data-table="dovecot_log">{{ lang.admin.refresh }}</button>
            </div>
          </div>
          <div class="card-body">
            <a class="btn btn-sm btn-secondary dropdown-toggle mb-4" data-bs-toggle="dropdown" href="#">{{ lang.mailbox.quick_actions }}</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item add_log_lines" data-post-process="general_syslog" data-table="dovecot_log" data-log-url="dovecot" data-nrows="100" href="#">+ 100</a></li>
              <li><a class="dropdown-item add_log_lines" data-post-process="general_syslog" data-table="dovecot_log" data-log-url="dovecot" data-nrows="1000" href="#">+ 1000</a></li>
              <li class="table_collapse_option"><hr class="dropdown-divider"></li>
              <li class="table_collapse_option"><a class="dropdown-item" data-datatables-expand="dovecot_log" data-table="dovecot_log" href="#">{{ lang.datatables.expand_all }}</a></li>
