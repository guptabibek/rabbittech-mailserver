  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ css_path }}">
  <script>
    // RabbitTech theme: light by default, dark once chosen with the toggle (stored in localStorage)
    (function () {
      var root = document.documentElement;
      root.classList.add('rt-js');
      // If a script fails before the shell is up (see 014-rabbittech.js), fall back to
      // mailcow's own tab navigation instead of leaving pages without one
      window.addEventListener('error', function (e) {
        if (root.classList.contains('rt-shell-ready')) return;
        if (e instanceof ErrorEvent || (e.target && e.target.tagName === 'SCRIPT')) root.classList.add('rt-shell-failed');
      }, true);
      var theme = null;
      try { theme = localStorage.getItem('mailcow_theme'); } catch (e) {}
      if (theme === 'dark') {
        root.setAttribute('data-theme', 'dark');
      }
      try {
        if (localStorage.getItem('rt_sidebar') === 'collapsed') {
          root.classList.add('rt-sidebar-collapsed');
        }
        // A #/<pane> URL picks the tab; stop mailcow from first reopening the last one,
        // which would run two tab transitions at once
        if (location.hash.indexOf('#/') === 0) {
          localStorage.removeItem('lastTag');
        }
      } catch (e) {}
    })();
  </script>

  <link rel="shortcut icon" href="/favicon.png" type="image/png">
  <link rel="icon" href="/favicon.png" type="image/png">
</head>
