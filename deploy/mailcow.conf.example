# Copy this file into the GitHub environment secret MAILCOW_ENV_FILE.
# Keep DBPASS, DBROOT, REDISPASS, and SOGO_URL_ENCRYPTION_KEY stable after first deployment.

MAILCOW_HOSTNAME=mail.rabbittech.com.np
MAILCOW_PASS_SCHEME=BLF-CRYPT

DBNAME=mailcow
DBUSER=mailcow
DBPASS=replace-with-long-random-value
DBROOT=replace-with-long-random-value
REDISPASS=replace-with-long-random-value

HTTP_PORT=80
HTTP_BIND=
HTTPS_PORT=443
HTTPS_BIND=
HTTP_REDIRECT=y

SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
DOVEADM_PORT=127.0.0.1:19991
SQL_PORT=127.0.0.1:13306
REDIS_PORT=127.0.0.1:7654

TZ=Asia/Kathmandu
COMPOSE_PROJECT_NAME=rabbittechmail
DOCKER_COMPOSE_VERSION=native
ACL_ANYONE=disallow
MAILDIR_GC_TIME=7200

ADDITIONAL_SAN=
AUTODISCOVER_SAN=y
ADDITIONAL_SERVER_NAMES=
SKIP_LETS_ENCRYPT=n
ACME_DNS_CHALLENGE=n
ACME_DNS_PROVIDER=dns_xxx
ACME_ACCOUNT_EMAIL=postmaster@rabbittech.com.np
ENABLE_SSL_SNI=n
SKIP_IP_CHECK=n
SKIP_HTTP_VERIFICATION=n
SKIP_UNBOUND_HEALTHCHECK=n

SKIP_CLAMD=n
SKIP_OLEFY=n
SKIP_SOGO=n
SKIP_FTS=n
FTS_HEAP=128
FTS_PROCS=1
ALLOW_ADMIN_EMAIL_LOGIN=n

USE_WATCHDOG=y
# Where the health monitor emails alerts (a service stops, an address is banned), e.g. you@example.com
WATCHDOG_NOTIFY_EMAIL=
WATCHDOG_NOTIFY_BAN=n
WATCHDOG_NOTIFY_START=y
WATCHDOG_EXTERNAL_CHECKS=n
WATCHDOG_VERBOSE=n
LOG_LINES=9999

IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64
MAILDIR_SUB=Maildir
SOGO_EXPIRE_SESSION=480
SOGO_URL_ENCRYPTION_KEY=replace16chars
DOVECOT_MASTER_USER=
DOVECOT_MASTER_PASS=
WEBAUTHN_ONLY_TRUSTED_VENDORS=n
SPAMHAUS_DQS_KEY=
ENABLE_IPV6=false
DISABLE_NETFILTER_ISOLATION_RULE=n

# RabbitTech nightly backups (scripts/backup-mail.sh, scheduled by the deploy)
RT_BACKUP=y
# Hour of the day (0-23, in TZ above) after which the daily backup runs
RT_BACKUP_HOUR=2
# Backups older than this are deleted; the newest two are always kept
RT_BACKUP_KEEP_DAYS=7
# Optional copy to another server over SSH, e.g. backup@nas.example.com:/srv/rabbittech-mail
RT_BACKUP_RSYNC_TARGET=
